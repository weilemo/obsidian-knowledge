    "import numpy as np\n",
    "import networkx as nx\n",
    "\n",
    "dict_G1 = {\n",
    "    0: [1, 4],\n",
    "    1: [0, 2, 3],\n",
    "    2: [0, 1, 3, 4 ,6],\n",
    "    3: [1, 2, 5],\n",
    "    4: [0, 2],\n",
    "    5: [3, 6],\n",
    "    6: [2, 5]\n",
    "}\n",
    "G1 = nx.Graph(dict_G1)\n",
    "bfs_tree_1 = nx.bfs_tree(G1, source=2)\n",
    "nx.draw(bfs_tree_1, with_labels=True)\n"
   ]
  }
